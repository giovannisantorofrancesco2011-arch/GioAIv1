# ---- Backend LLM (qualsiasi server compatibile OpenAI) ----
# Ollama (default)        -> http://localhost:11434/v1
# LM Studio               -> http://localhost:1234/v1
# vLLM                    -> http://localhost:8001/v1
# llama.cpp llama-server  -> http://localhost:8080/v1
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama

# Profilo hardware: cpu | gpu8 | gpu16 | gpu24
MYDEVAGENT_PROFILE=gpu8

# Override opzionali dei modelli per tier (lascia vuoto per usare il profilo)
# MYDEVAGENT_MODEL_MAIN=qwen2.5-coder:7b
# MYDEVAGENT_MODEL_FAST=qwen2.5-coder:1.5b
# MYDEVAGENT_MODEL_REASONING=qwen3:8b
# MYDEVAGENT_MODEL_VISION=qwen2.5vl:7b
# MYDEVAGENT_MODEL_EMBED=nomic-embed-text

# ---- Ricerca web (tutte opzionali: senza chiavi usa DuckDuckGo) ----
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
SEARXNG_URL=
# Forza la modalità offline (nessuna chiamata di rete verso internet)
# MYDEVAGENT_OFFLINE=1

# ---- Server OpenAI-compatibile ----
# Se esponi il server fuori da localhost (es. per Cursor), imposta una chiave!
MYDEVAGENT_API_KEY=
